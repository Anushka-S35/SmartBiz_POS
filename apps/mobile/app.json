{
  "expo": {
    "name": "SmartBiz POS",
    "slug": "smartbiz-pos",
    "scheme": "smartbizpos",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartbiz.pos"
    },
    "android": {
      "package": "com.smartbiz.pos",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
